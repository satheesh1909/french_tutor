# Copy this file to .env.local and fill in your keys.

# --- Claude: the tutor brain (conversation, corrections, session reviews) ---
# Create a key at https://console.anthropic.com (separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=

# Live conversation turns. Opus 5 at low effort is accurate and reasonably quick.
# For snappier replies you can try claude-sonnet-5.
CLAUDE_TUTOR_MODEL=claude-opus-5
CLAUDE_TUTOR_EFFORT=low
# End-of-session review: level estimates, focus areas, next-lesson plan.
CLAUDE_REVIEW_MODEL=claude-opus-5
CLAUDE_REVIEW_EFFORT=high

# --- Gemini: ears, voice, quiz generator ---
# The SDK also picks up GOOGLE_API_KEY from your system environment.
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Erinome
GEMINI_TEXT_MODEL=gemini-3.8-flash

# --- Ollama (local): remembers and groups your mistakes ---
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Tutor persona ---
TUTOR_NAME=Charlotte
