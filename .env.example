# Copy this file to .env.local and fill in your keys.
# The model and voice values below are only defaults: the Settings page in the app overrides them.

# --- Claude: the tutor brain (conversation, corrections, session reviews) ---
# Create a key at https://console.anthropic.com (separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=
# Only for an organisation-wide key, which Anthropic refuses unless the request names a workspace.
# A key created inside a workspace needs none of this.
# ANTHROPIC_WORKSPACE_ID=

# Live conversation turns. Opus 5 at low effort is accurate and reasonably quick.
# For snappier replies you can try claude-sonnet-5.
CLAUDE_TUTOR_MODEL=claude-opus-5
CLAUDE_TUTOR_EFFORT=low
# End-of-session review: level estimates, focus areas, next-lesson plan.
CLAUDE_REVIEW_MODEL=claude-opus-5
CLAUDE_REVIEW_EFFORT=high

# --- Gemini: ears, voice, quiz generator ---
# The SDK also picks up GOOGLE_API_KEY from your system environment.
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Erinome
GEMINI_TEXT_MODEL=gemini-3.8-flash

# --- Ollama (local): remembers and groups your mistakes ---
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Local Whisper (speech to text + speaking speed): start it with "npm run whisper" ---
WHISPER_URL=http://127.0.0.1:8765
# Read by whisper_server/server.py when you start it (set them in that terminal):
# WHISPER_MODEL=medium      (small is faster; large-v3 is the bigger model, measured below)
# WHISPER_DEVICE=auto       (auto, cuda or cpu)
# WHISPER_COMPUTE_TYPE=     (blank keeps float16 on the GPU; int8_float16 halves the weights, but
#                            a Blackwell laptop GPU refuses it - cuBLAS says not supported)
#
# Measured on an RTX 5070 Laptop (8 GB), a 1.5 s and an 11.4 s clip:
#   medium   float16   2357 MiB   0.92 s / 3.13 s
#   large-v3 float16   4128 MiB   1.50 s / 4.92 s
# So large-v3 costs about 60% more latency per turn and 1.8 GB more memory, which it has to earn.
# Judge it on your own voice, not on ours: whisper_server/compare.py replays the recordings the app
# kept through both and prints them side by side.
#
# WHISPER_FALLBACK_LANGUAGE=fr        which of French/English to assume when neither is convincing
# WHISPER_MIN_LANGUAGE_MARGIN=0.6     how far ahead the winner must be of the other candidate
# WHISPER_MIN_LANGUAGE_LIKELIHOOD=0.5 how probable it must be among all languages Whisper knows

# How many recent recordings to keep in data/recordings, with what was transcribed from each, so a
# turn that came back wrong can be replayed instead of guessed at. 0 keeps none.
# KEEP_RECORDINGS=20

# --- Local voice (Piper, the quick one): start it with "npm run piper" ---
PIPER_URL=http://127.0.0.1:8768
# Read by piper_server/server.py when you start it (set them in that terminal):
# PIPER_VOICE_FR=fr_FR-siwis-medium
# PIPER_VOICE_EN=en_GB-cori-high
# PIPER_FR_SPEED=0.92    (how fast she speaks French; 1.0 is the voice's own pace)

# --- Local voice (XTTS, one voice for both languages but slow): start it with "npm run voice" ---
XTTS_URL=http://127.0.0.1:8767
# Read by voice_server/server.py when you start it (set them in that terminal):
# XTTS_SPEAKER=             (a built-in speaker, or the name of a wav in voice_server/voices)
# XTTS_DEVICE=auto          (auto, cuda or cpu; cpu is far too slow for a conversation)

# --- Tutor persona ---
TUTOR_NAME=Alice
